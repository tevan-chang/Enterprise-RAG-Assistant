# 只放 key 名稱，不放真實值。真實值走 local .env（不進 git）與 Render/Vercel 後台環境變數。
# 見 docs/spec_v3.1.md §1 / docs/dev_roadmap_v3.1.md Phase 0

OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=          # 後端驗證前端 Supabase Auth JWT 用（Legacy JWT Secret / HS256，Dashboard → Project Settings → API → JWT Settings；本機用 `supabase status` 查）
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
SYNC_API_KEY=
ALLOWED_ORIGINS=
LLAMA_CLOUD_API_KEY=          # LlamaParse fallback 用，PDF/XLSX 解析異常時觸發（§1 文件解析 Fallback）